# Supabase project URL, e.g. https://xyzcompany.supabase.co
SUPABASE_URL=

# Anon/public key (Project Settings > API) — used for Supabase Auth flows
# (sign up / sign in), exactly like the browser client would use.
SUPABASE_ANON_KEY=

# Service role key (Project Settings > API) — server-side only, bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# JWT secret (Project Settings > API > JWT Settings) — used to verify the
# Bearer tokens issued by Supabase Auth for admin-only endpoints.
SUPABASE_JWT_SECRET=

# Origin allowed to call this API via CORS (the Next.js frontend).
FRONTEND_ORIGIN=http://localhost:3000
