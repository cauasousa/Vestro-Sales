# Supabase project URL, e.g. https://xyzcompany.supabase.co
SUPABASE_URL=

# Anon/public key (Project Settings > API) — used for Supabase Auth flows
# (sign up / sign in), exactly like the browser client would use.
SUPABASE_ANON_KEY=

# Service role key (Project Settings > API) — server-side only, bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# JWT secret (Project Settings > API > JWT Settings) — used to verify the
# Bearer tokens issued by Supabase Auth for admin-only endpoints.
SUPABASE_JWT_SECRET=

# Origin allowed to call this API via CORS (the Next.js frontend).
FRONTEND_ORIGIN=http://localhost:3000

# Google AI Studio API key (https://aistudio.google.com/apikey) — powers the
# AI Assistant (POST /api/ai/assistant). Left empty, the assistant falls back
# to a keyword-matched answer over live Supabase data instead of erroring.
GEMINI_API_KEY=

# Optional — defaults to gemini-flash-latest if unset. Pin an exact version
# (e.g. gemini-2.5-flash) only once you've confirmed it's live on your key —
# dated model names get sunset by Google and start 404ing without warning.
GEMINI_MODEL=gemini-flash-latest

# Resend API key (https://resend.com/api-keys) — powers admin marketing/event
# emails (POST /api/marketing/send). Left empty, that endpoint returns a clear
# 400 instead of silently failing (unlike the assistant/forecast, there's no
# sensible "fallback" for an email that was supposed to be sent).
RESEND_API_KEY=

# Sender address for those emails. Must be on a domain verified in Resend
# (https://resend.com/domains) — defaults to Resend's shared test sender,
# which only delivers to the email the API key's Resend account was signed
# up with, fine for local testing but not for real sends.
RESEND_FROM_EMAIL=onboarding@resend.dev
